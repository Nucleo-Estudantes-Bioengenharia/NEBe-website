# Prefixo de caminho do site. Necessário quando o site é servido numa subpasta,
# como acontece no GitHub Pages de um repositório (https://<org>.github.io/<repo>).
# Deixa vazio para servir na raiz do domínio (ex.: Docker local ou domínio próprio).
NEXT_PUBLIC_BASE_PATH=

# URL público completo do site (usado nos metadados Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Porta do anfitrião onde o docker compose expõe o site.
PORT=8080
